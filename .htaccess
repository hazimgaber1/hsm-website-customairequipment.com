# Custom Air Equipment website (Apache 2.4 with mod_rewrite).
Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain. On AWS the load balancer ends HTTPS and
# says which scheme the visitor used in X-Forwarded-Proto.
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://customairequipment.com%{REQUEST_URI} [L,R=301]

# Private folders.
RewriteRule ^(data|inc|tools|docker)(/|$) - [F,L]
RewriteRule ^Dockerfile$ - [F,L]
RewriteRule (^|/)_ - [F,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /page.php -> /page (one canonical URL per page).
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ https://customairequipment.com/%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index[\s?] [NC]
RewriteRule ^ https://customairequipment.com/%1 [R=301,L]

# /page -> page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(css|js|png|jpe?g|webp|svg|pdf|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<FilesMatch "\.(sqlite|json|md|sh|py)$">
Require all denied
</FilesMatch>
